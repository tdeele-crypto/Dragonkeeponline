# Copy to deploy/backend.env and fill in real values, then it is injected into
# the backend container via --env-file (never baked into the image).
#
# Reuse the existing host MongoDB, but with an ISOLATED database name so your
# indkoeb app is completely untouched.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dragonkeeper
#
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
#
# If your host mongod requires authentication, use instead e.g.:
# MONGO_URL=mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=admin
