# Copy to deploy/backend.env and fill in real values, then it is injected into
# the backend container via --env-file (never baked into the image).
#
# Reuse the existing host MongoDB, but with an ISOLATED database name so your
# indkoeb app is completely untouched.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dragonkeeper
#
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
#
# --- Password reset via Gmail SMTP ---
# Gmail account that sends the reset emails, and a Google App Password
# (16 chars, from Google Account -> Security -> App passwords; spaces are ok).
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Public URL of the reset-password page (the deployed web app + /reset-password).
RESET_WEB_URL=https://dragonkeeper.deele.dk/reset-password
# How long a reset link stays valid.
RESET_TOKEN_MINUTES=30
#
# If your host mongod requires authentication, use instead e.g.:
# MONGO_URL=mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=admin
